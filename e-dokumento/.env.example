# Copy to .env for local development only. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only. Used only to create and deactivate staff accounts (Users page).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Public base URL of the app, no trailing slash (used in auth email links)
APP_URL=http://localhost:8000

# 64 random hex characters. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=replace-with-64-random-hex-characters

# true shows error details on the error page. Keep false in production.
APP_DEBUG=false

# Gmail settings for status emails (optional; Settings -> Email notifications).
# MAIL_APP_PASSWORD is a Gmail app password (2-Step Verification on, then
# myaccount.google.com -> Security -> App passwords), not your Gmail password.
MAIL_USERNAME=your-barangay@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=Barangay San Isidro e-Dokumento
