{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30,
      "excludeFiles": "{sql/**,docs/**,tools/**,.vscode/**,node_modules/**}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "headers": { "cache-control": "public, max-age=86400" }, "dest": "/assets/$1" },
    { "src": "/favicon.ico", "dest": "/assets/img/favicon.svg" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
