  puroks ||--o{ residents : "houses"
  residents ||--o{ resident_verifications : "submits"
  id_types ||--o{ resident_verifications : "presented as"
  profiles |o--o{ resident_verifications : "reviews"
  document_types ||--o{ document_type_requirements : "requires"
  requirements ||--o{ document_type_requirements : "required by"
  residents ||--o{ document_requests : "requests"
  document_types ||--o{ document_requests : "requested as"
  purposes ||--o{ document_requests : "stated for"
  profiles ||--o{ document_requests : "encodes"
  document_requests ||--o{ request_attachments : "has"
  requirements |o--o{ request_attachments : "satisfied by"
  document_requests ||--o{ request_status_history : "logs"
  document_requests ||--o{ payments : "paid by"
  profiles ||--o{ payments : "receives"
  document_requests ||--o| issued_documents : "produces"
  barangay_officials ||--o{ issued_documents : "signs"
  profiles ||--o{ notifications : "receives"
