  profiles |o--o{ audit_logs : "performs"
  profiles |o--o{ system_settings : "last updates"
  roles {
    smallint id PK
    text code UK
    text name
  }
  profiles {
    uuid id PK "FK auth.users.id"
    smallint role_id FK
    text email UK
    text full_name
    text status
  }
  puroks {
    smallint id PK
    text name UK
    boolean is_active
  }
  residents {
    uuid id PK
    uuid profile_id FK "UK, nullable"
    smallint purok_id FK
    text first_name
    text last_name
    date birth_date
    date resident_since
    text verification_status
    text status
  }
  id_types {
    smallint id PK
    text name UK
  }
  resident_verifications {
    uuid id PK
    uuid resident_id FK
    smallint id_type_id FK
    text id_number
    text status
    uuid reviewed_by FK
  }
  document_types {
    smallint id PK
    text code UK
    text name UK
    numeric fee
    smallint processing_days
    boolean requires_captain_approval
    boolean once_per_lifetime
    text template_key
  }
  requirements {
    smallint id PK
    text name UK
    boolean accepts_upload
  }
  document_type_requirements {
    smallint document_type_id PK "FK"
    smallint requirement_id PK "FK"
    boolean is_mandatory
  }
  purposes {
    smallint id PK
    text name UK
  }
  document_requests {
    uuid id PK
    text control_no UK
    uuid resident_id FK
    smallint document_type_id FK
    smallint purpose_id FK
    jsonb extra_details
    numeric fee_amount
    text status
    uuid requested_by FK
  }
  request_attachments {
    uuid id PK
    uuid request_id FK
    smallint requirement_id FK
    text file_path UK
    text review_status
  }
  request_status_history {
    bigint id PK
    uuid request_id FK
    text from_status
    text to_status
    uuid changed_by FK
  }
  payments {
    uuid id PK
    uuid request_id FK
    text or_number UK
    numeric amount
    text method
    text status
    uuid received_by FK
  }
  barangay_officials {
    smallint id PK
    text full_name
    text position
    date term_end
    boolean is_active
  }
  issued_documents {
    uuid id PK
    uuid request_id FK "UK"
    text document_no UK
    text verification_code UK
    smallint signatory_id FK
    text status
  }
  notifications {
    bigint id PK
    uuid recipient_id FK
    uuid request_id FK
    boolean is_read
  }
  audit_logs {
    bigint id PK
    uuid actor_id FK
    text action
    text entity_type
    jsonb details
  }
  system_settings {
    text key PK
    jsonb value
    uuid updated_by FK
  }
